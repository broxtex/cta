# Copia este archivo a .env para desarrollo local (opcional).
# En Vercel configura estas variables en Project Settings → Environment Variables.

# Neon Postgres connection string (requerido en producción)
# Ejemplo: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto de autenticación (genera uno largo y aleatorio, mínimo 32 caracteres)
# Ejemplo: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app en Vercel (sin slash final)
# Ejemplo: https://tu-proyecto.vercel.app
BETTER_AUTH_URL=

# Contraseña inicial del dueño (solo se usa la primera vez que arranca)
# Si no la pones, se usa "smith2026"
SMITH_OWNER_PASSWORD=

# Opcional: clave de xAI para sugerencias de prendas
XAI_API_KEY=
